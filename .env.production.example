# ─────────────────────────────────────────────────────────────────────────────
# Nexus OMS — Variables para PRODUCCIÓN
#
# 1. Copia este archivo: cp .env.production.example .env.production
# 2. Completa TODOS los valores marcados con  ← CAMBIAR  (si falta uno,
#    la app falla al arrancar a propósito: fail fast).
# 3. .env.production está excluido de la imagen Docker (.dockerignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-real-random-secret-key   # ← CAMBIAR
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
ALLOWED_HOSTS=nexus.com,www.nexus.com           # ← CAMBIAR
CSRF_TRUSTED_ORIGINS=https://nexus.com          # ← CAMBIAR

# ── Email SMTP ────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net                    # ← CAMBIAR
EMAIL_PORT=587
EMAIL_HOST_USER=apikey                          # ← CAMBIAR
EMAIL_HOST_PASSWORD=your-sendgrid-api-key       # ← CAMBIAR
DEFAULT_FROM_EMAIL=noreply@nexusoms.com

# ── Base de datos ─────────────────────────────────────────────────────────────
# Deben coincidir con POSTGRES_* de docker-compose.prod.yml (o el host real).
DATABASE_URL=postgres://nexus_user:nexus_pass@db:5432/nexus_db   # ← CAMBIAR

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ── Integraciones ─────────────────────────────────────────────────────────────
MIGO_API_TOKEN=your-migo-api-token              # ← CAMBIAR

# ── Servicios opcionales ──────────────────────────────────────────────────────
# Solo para docker-compose.prod.yml (flower no arranca sin esto)
# FLOWER_BASIC_AUTH=user:password
