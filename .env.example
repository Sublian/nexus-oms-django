# ─────────────────────────────────────────────────────────────────────────────
# Nexus OMS — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copia este archivo: cp .env.example .env
# 2. Ajusta los valores marcados con  ← CAMBIAR  antes de levantar el proyecto.
# 3. Nunca subas el .env real al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────

# Clave secreta de Django. Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-generate-your-own-secret-key   # ← CAMBIAR

# Módulo de settings activo. Opciones:
#   config.settings.local      → desarrollo local
#   config.settings.testing    → suite de pruebas (pytest lo sobreescribe automáticamente)
#   config.settings.production → producción
DJANGO_SETTINGS_MODULE=config.settings.local

# Solo necesario en producción. Separar múltiples hosts con coma: "nexus.com,www.nexus.com"
# ALLOWED_HOSTS=nexus.com,www.nexus.com

# Configuración de email (solo producción)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key   # ← CAMBIAR
# DEFAULT_FROM_EMAIL=noreply@nexusoms.com

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
# Formato: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
# Los valores deben coincidir con los definidos en docker-compose.yml
DB_NAME=nombre_db
DB_USER=nombre_user
DB_PASSWORD=clave_pass
DB_HOST=host_db
DB_PORT=puerto
DATABASE_URL=url_database (ejemplo postgres://nexus_user:nexus_pass@db:5432/nexus_db)

# ── Redis ─────────────────────────────────────────────────────────────────────
# Usado por Celery (broker + backend) y por el sistema de caché.
# "redis" es el nombre del servicio en docker-compose.yml.
REDIS_URL=redis://redis:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
# False en desarrollo normal (workers reales vía Docker Compose).
# True solo en tests para ejecutar tareas de forma síncrona sin worker.
CELERY_TASK_ALWAYS_EAGER=False
